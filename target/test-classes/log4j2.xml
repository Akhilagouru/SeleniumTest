<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </Console>
        
        <!--Routing appender creates seperate log file for each class-->
        <Routing name="Routing">

            <Routes pattern="$${ctx:className}">

                <Route>
                    <File
                        name="File-${ctx:className}"
                        fileName="logs/${ctx:className}.log">

                        <PatternLayout>
                            <Pattern>
                                %d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n
                            </Pattern>
                        </PatternLayout>

                    </File>
                </Route>

            </Routes>

        </Routing>

    </Appenders>

    <Loggers>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Routing"/>
        </Root>

    </Loggers>

</Configuration>